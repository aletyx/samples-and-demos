{
  "name": "Mortgage Hub",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  // The dev servers must listen on every interface for the forwarded
  // ports to reach them (only the container sees them).
  "containerEnv": {
    "MORTGAGEHUB_BIND_HOST": "0.0.0.0"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [8880],
  "portsAttributes": {
    "8880": { "label": "Flutter web" }
  },
  "postCreateCommand": "bash -lc 'bash .devcontainer/post-create.sh'"
}
