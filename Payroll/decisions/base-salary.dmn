        <di:waypoint x="590" y="260"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_70c2a9b892e2" dmnElementRef="_ar_c5d4bb620585">
        <di:waypoint x="810" y="190"/>
        <di:waypoint x="150" y="260"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_a1dbfe284f83" dmnElementRef="_kr_78f51cede42a">
        <di:waypoint x="590" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_be04e8acd61a" dmnElementRef="_kr_fbe817a5416e">
        <di:waypoint x="150" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_256737c3b38e" dmnElementRef="_kr_f8c4033b1096">
        <di:waypoint x="370" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_3f4cc991c5b9" dmnElementRef="_ar_8c2f16fd3607">
        <di:waypoint x="810" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
