  <businessKnowledgeModel id="_bkm_67e8224daf31" name="Experience Adjustment">
    <variable id="_var_249b116c9113" name="Experience Adjustment" typeRef="types.tModifierResult"/>
    <encapsulatedLogic id="_fn_1dc71b9fb3ab" kind="FEEL" typeRef="types.tModifierResult">
      <formalParameter id="_fp_81a9d6ac778a" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_3858324edf0d" name="yearsExperience" typeRef="types.tYears"/>
      <formalParameter id="_fp_d2b8c7f5612a" name="roleExpectedYears" typeRef="types.tYears"/>
      <formalParameter id="_fp_235511254f2c" name="seniorityScore" typeRef="types.tSeniorityScore"/>
      <formalParameter id="_fp_7666861ac0c5" name="requisitionStatus" typeRef="types.tRequisitionStatus"/>
      <formalParameter id="_fp_3b8a192fcb28" name="coreDomainExperience" typeRef="boolean"/>
      <formalParameter id="_fp_3d607e0c3a9b" name="boomerang" typeRef="boolean"/>
      <context id="_ctx_bf3027405adc" typeRef="types.tModifierResult">
        <contextEntry id="_ce_a09c958df7e3">
          <variable id="_cev_5de3d6a43592" name="rules" typeRef="types.tAppliedRuleList"/>
          <literalExpression id="_le_77ae13368652">
            <text>Experience Rules(baseSalary, yearsExperience, roleExpectedYears,
  seniorityScore, requisitionStatus, coreDomainExperience, boomerang)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_fedb146d54e3">
          <variable id="_cev_647b56d1d114" name="raised" typeRef="types.tFlagList"/>
          <literalExpression id="_le_7c50d26e245a">
            <text>[]</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_f7b829dd2fee">
          <literalExpression id="_le_52678678f831">
            <text>{ amount: common.Sum Of Rules(rules),
  appliedRules: if rules = null then [] else rules,
  flags: if raised = null then [] else raised }</text>
          </literalExpression>
        </contextEntry>
      </context>
    </encapsulatedLogic>
