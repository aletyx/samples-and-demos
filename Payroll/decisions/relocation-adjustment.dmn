  <knowledgeSource id="_ks_5e0b0da4397f" name="Relocation Policy" locationURI="../spec/candidate_offer.md#9-group-3--relocation-and-work-mode">
    <description>Section 9: relocation and work mode. Lump-sum moving costs are handled by the relocation policy and are deliberately out of this model.</description>
    <type>Policy document</type>
  </knowledgeSource>
  <businessKnowledgeModel id="_bkm_c9be706799ac" name="Relocation Rules">
    <description>MOD-LOC-01 to MOD-LOC-06, collected.</description>
    <variable id="_var_67e88f7d66e5" name="Relocation Rules" typeRef="types.tAppliedRuleList"/>
    <encapsulatedLogic id="_fn_415043895b2a" kind="FEEL" typeRef="types.tAppliedRuleList">
      <formalParameter id="_fp_3541daf2daad" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_c741191c8b12" name="relocationRequired" typeRef="boolean"/>
      <formalParameter id="_fp_7db08f88d869" name="relocationScope" typeRef="types.tRelocationScope"/>
      <formalParameter id="_fp_f6e6cbfafff6" name="indexDrop" typeRef="boolean"/>
