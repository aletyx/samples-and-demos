      <formalParameter id="_fp_90c65267cf4f" name="remoteEligibleRole" typeRef="boolean"/>
      <decisionTable id="_dt_dbe4f4cdc6d5" typeRef="types.tAppliedRuleList" hitPolicy="COLLECT" preferredOrientation="Rule-as-Row" outputLabel="Applied rule">
