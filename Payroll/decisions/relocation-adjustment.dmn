          <inputExpression id="_ie_54d206643ee1" typeRef="types.tWorkMode">
            <text>workMode</text>
          </inputExpression>
        </input>
        <input id="_in_97a40d6f4b39" label="US Tier 1 market">
          <inputExpression id="_ie_ac9c9e874312" typeRef="boolean">
            <text>isUsTier1</text>
          </inputExpression>
        </input>
        <input id="_in_ac9957c32985" label="Role is remote eligible">
          <inputExpression id="_ie_10aabb32d5a6" typeRef="boolean">
            <text>remoteEligibleRole</text>
          </inputExpression>
        </input>
        <output id="_out_9b8bfad4d316" name="ruleId" typeRef="types.tRuleId"/>
        <output id="_out_da25ad07989b" name="description" typeRef="string"/>
        <output id="_out_421c4063daf5" name="amount" typeRef="types.tAmount"/>
        <annotation name="Specification rule"/>
        <rule id="_rule_ce0a9cc297aa">
          <description>Permanent salary uplift, not a moving allowance.</description>
          <inputEntry id="_rule_ce0a9cc297aa_i0">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_ce0a9cc297aa_i1">
            <text>"domestic"</text>
          </inputEntry>
          <inputEntry id="_rule_ce0a9cc297aa_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ce0a9cc297aa_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ce0a9cc297aa_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ce0a9cc297aa_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_ce0a9cc297aa_o0">
            <text>"MOD-LOC-01"</text>
          </outputEntry>
          <outputEntry id="_rule_ce0a9cc297aa_o1">
            <text>"Domestic relocation uplift of 4%"</text>
          </outputEntry>
          <outputEntry id="_rule_ce0a9cc297aa_o2">
            <text>baseSalary * 0.04</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-LOC-01</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_3505fc9a8026">
          <description>Permanent salary uplift, not a moving allowance.</description>
          <inputEntry id="_rule_3505fc9a8026_i0">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_3505fc9a8026_i1">
            <text>"international"</text>
          </inputEntry>
          <inputEntry id="_rule_3505fc9a8026_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3505fc9a8026_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3505fc9a8026_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3505fc9a8026_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_3505fc9a8026_o0">
            <text>"MOD-LOC-02"</text>
          </outputEntry>
          <outputEntry id="_rule_3505fc9a8026_o1">
            <text>"International relocation uplift of 7%"</text>
          </outputEntry>
          <outputEntry id="_rule_3505fc9a8026_o2">
            <text>baseSalary * 0.07</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-LOC-02</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_1fa38e083592">
          <description>Softens a move to a cheaper market.</description>
          <inputEntry id="_rule_1fa38e083592_i0">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_1fa38e083592_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_1fa38e083592_i2">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_1fa38e083592_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_1fa38e083592_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_1fa38e083592_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_1fa38e083592_o0">
            <text>"MOD-LOC-03"</text>
          </outputEntry>
          <outputEntry id="_rule_1fa38e083592_o1">
            <text>"Destination market index is below the candidate current market, 3%"</text>
          </outputEntry>
          <outputEntry id="_rule_1fa38e083592_o2">
            <text>baseSalary * 0.03</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-LOC-03</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_ca0fd484833c">
          <inputEntry id="_rule_ca0fd484833c_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ca0fd484833c_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ca0fd484833c_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ca0fd484833c_i3">
            <text>"onsite"</text>
          </inputEntry>
          <inputEntry id="_rule_ca0fd484833c_i4">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_ca0fd484833c_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_ca0fd484833c_o0">
            <text>"MOD-LOC-04"</text>
          </outputEntry>
          <outputEntry id="_rule_ca0fd484833c_o1">
            <text>"Onsite in a US Tier 1 market, commute compensation of 2%"</text>
          </outputEntry>
          <outputEntry id="_rule_ca0fd484833c_o2">
            <text>baseSalary * 0.02</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-LOC-04</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_6be58ff018ad">
          <description>Recorded so the rationale shows it was considered.</description>
          <inputEntry id="_rule_6be58ff018ad_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6be58ff018ad_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6be58ff018ad_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6be58ff018ad_i3">
            <text>"remote"</text>
          </inputEntry>
          <inputEntry id="_rule_6be58ff018ad_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6be58ff018ad_i5">
            <text>true</text>
          </inputEntry>
          <outputEntry id="_rule_6be58ff018ad_o0">
            <text>"MOD-LOC-05"</text>
          </outputEntry>
          <outputEntry id="_rule_6be58ff018ad_o1">
            <text>"Remote in a remote-eligible role, no change"</text>
          </outputEntry>
          <outputEntry id="_rule_6be58ff018ad_o2">
            <text>0</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-LOC-05</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_3c2c3b12d44e">
          <inputEntry id="_rule_3c2c3b12d44e_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3c2c3b12d44e_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3c2c3b12d44e_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_3c2c3b12d44e_i3">
            <text>"hybrid"</text>
          </inputEntry>
          <inputEntry id="_rule_3c2c3b12d44e_i4">
            <text>-</text>
