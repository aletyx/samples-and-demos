  <description>Section 7, group 1. The only multiplicative modifier.</description>
  <import id="_imp_4db307b23367" name="types" importType="https://www.omg.org/spec/DMN/20230324/MODEL/" namespace="https://aletyx.ai/dmn/payroll/types" locationURI="payroll-types.dmn"/>
  <knowledgeSource id="_ks_6c4f9ebbc197" name="Market Index Policy" locationURI="../spec/candidate_offer.md#7-group-1--market-adjustment">
    <description>Section 7: the index applied to the reference range for the location the candidate will be employed in. Reviewed twice a year under GOV-02.</description>
    <type>Policy document</type>
  </knowledgeSource>
  <businessKnowledgeModel id="_bkm_67f06d8fa69b" name="Market Index">
    <description>City first, then country, then regional fallback. Because tMarketCode is an enumeration, MOD-MKT-90 (unknown market) cannot happen here; it is trapped in validation instead.</description>
    <variable id="_var_c32523b5d218" name="Market Index" typeRef="types.tMarketIndex"/>
