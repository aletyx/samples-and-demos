  <businessKnowledgeModel id="_bkm_d1c123bc2751" name="Is US Tier 1">
    <description>US Tier 1 markets, used by MOD-LOC-04.</description>
    <variable id="_var_ca4c7775a333" name="Is US Tier 1" typeRef="boolean"/>
    <encapsulatedLogic id="_fn_c990ef2e09dd" kind="FEEL" typeRef="boolean">
      <formalParameter id="_fp_2de21567285d" name="marketCode" typeRef="types.tMarketCode"/>
      <literalExpression id="_le_2648fcf27bfd">
        <text>list contains(["US-SF", "US-NYC", "US-SEA"], marketCode)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_dd88a592428d" name="Is European Statutory Market">
    <description>Markets in sections 7.2 to 7.5, where MOD-DED-04 applies.</description>
    <variable id="_var_4714df8f4d15" name="Is European Statutory Market" typeRef="boolean"/>
    <encapsulatedLogic id="_fn_21047202de91" kind="FEEL" typeRef="boolean">
      <formalParameter id="_fp_69c80fd8ad27" name="marketCode" typeRef="types.tMarketCode"/>
      <literalExpression id="_le_d70ce62b76b5">
        <text>list contains(
  ["UK-LON", "UK-OTH", "IE-DUB", "IE-OTH", "CH-ZRH", "CH-OTH", "DE-MUC", "DE-BER", "DE-OTH", "NL-AMS", "NL-OTH", "FR-PAR", "FR-OTH", "BE-BRU", "BE-OTH", "LU-LUX", "AT-VIE", "AT-OTH", "DK-CPH", "SE-STO", "SE-OTH", "NO-OSL", "FI-HEL", "IS-REY", "ES-MAD", "ES-OTH", "PT-LIS", "PT-OTH", "IT-MIL", "IT-OTH", "GR-ATH", "CY-NIC", "MT-MLA", "PL-WAW", "PL-OTH", "CZ-PRG", "CZ-OTH", "SK-BTS", "HU-BUD", "RO-BUC", "RO-OTH", "BG-SOF", "HR-ZAG", "SI-LJU", "RS-BEG", "EE-TLL", "LV-RIX", "LT-VNO", "UA-KYI", "TR-IST", "EU-OTH"],
  marketCode)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_f522a08c291f" name="Market Adjustment">
    <description>Expressed as an amount added to the base so that every group sums the same way. base x index equals base + base x (index - 1).</description>
    <variable id="_var_f2f414bc2905" name="Market Adjustment" typeRef="types.tModifierResult"/>
    <encapsulatedLogic id="_fn_7d7415fc9cfa" kind="FEEL" typeRef="types.tModifierResult">
      <formalParameter id="_fp_91f3fc34966f" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_bf3118a8cfc5" name="marketCode" typeRef="types.tMarketCode"/>
      <formalParameter id="_fp_81f3aee15702" name="legalEntityExists" typeRef="boolean"/>
      <context id="_ctx_581b8b10bd62" typeRef="types.tModifierResult">
        <contextEntry id="_ce_4f5aad22014b">
          <variable id="_cev_a64460574ac3" name="index" typeRef="types.tMarketIndex"/>
          <literalExpression id="_le_0b0c1bb71d5c">
            <text>Market Index(marketCode)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_0b35361db457">
          <variable id="_cev_311c8b02a6f8" name="amount" typeRef="number"/>
          <literalExpression id="_le_04d26c586958">
            <text>baseSalary * (index.index - 1)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_6ade72823029">
          <literalExpression id="_le_785023011afc">
            <text>{ amount: amount,
  appliedRules: [ { ruleId: index.ruleId,
      description: index.location + " has a market index of "
        + string(index.index),
      amount: amount } ],
  flags: if legalEntityExists = false then ["EOR_REVIEW"] else [] }</text>
          </literalExpression>
        </contextEntry>
      </context>
    </encapsulatedLogic>
    <knowledgeRequirement id="_kr_ac9d58471234">
      <requiredKnowledge href="#_bkm_67f06d8fa69b"/>
    </knowledgeRequirement>
    <authorityRequirement id="_ar_63850fb7d579">
      <requiredAuthority href="#_ks_6c4f9ebbc197"/>
    </authorityRequirement>
  </businessKnowledgeModel>
