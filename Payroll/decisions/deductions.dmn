  <businessKnowledgeModel id="_bkm_cbc94e8a72fe" name="Deduction Rules">
    <variable id="_var_050bed5240f5" name="Deduction Rules" typeRef="types.tAppliedRuleList"/>
    <encapsulatedLogic id="_fn_12160b5056a3" kind="FEEL" typeRef="types.tAppliedRuleList">
      <formalParameter id="_fp_3a8827f7cb8e" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_6c4e22d25e7c" name="subtotal" typeRef="number"/>
      <formalParameter id="_fp_e64cc3d33015" name="band" typeRef="types.tSeniorityBand"/>
      <formalParameter id="_fp_5e57a0b7ef6a" name="roleLevel" typeRef="number"/>
      <formalParameter id="_fp_457a7174a7cb" name="missingHardRequirement" typeRef="boolean"/>
      <formalParameter id="_fp_097daadd09e8" name="partTimeFraction" typeRef="types.tFraction"/>
      <formalParameter id="_fp_c2b0e823235c" name="isEuropeanStatutoryMarket" typeRef="boolean"/>
      <formalParameter id="_fp_fc8aa7446934" name="contractToHire" typeRef="boolean"/>
      <decisionTable id="_dt_32902514acd3" typeRef="types.tAppliedRuleList" hitPolicy="COLLECT" preferredOrientation="Rule-as-Row" outputLabel="Applied rule">
        <input id="_in_4c0c83351a71" label="Seniority band">
          <inputExpression id="_ie_75bc8dcfd74d" typeRef="types.tSeniorityBand">
            <text>band</text>
          </inputExpression>
        </input>
        <input id="_in_dd0b7cdfc985" label="Role level">
          <inputExpression id="_ie_484eaba814d6" typeRef="number">
            <text>roleLevel</text>
          </inputExpression>
        </input>
        <input id="_in_3825431275f9" label="Missing a hard requirement">
          <inputExpression id="_ie_d240aa6a021c" typeRef="boolean">
            <text>missingHardRequirement</text>
          </inputExpression>
        </input>
        <input id="_in_5b5911d27a01" label="Fraction of full time">
          <inputExpression id="_ie_6fe7a627edef" typeRef="types.tFraction">
            <text>partTimeFraction</text>
          </inputExpression>
        </input>
        <input id="_in_71fa18daf7bf" label="Statutory benefit market">
          <inputExpression id="_ie_9cc8ab1a64e9" typeRef="boolean">
            <text>isEuropeanStatutoryMarket</text>
          </inputExpression>
        </input>
        <input id="_in_e3648632e230" label="Contract to hire">
          <inputExpression id="_ie_71b595094fbb" typeRef="boolean">
            <text>contractToHire</text>
          </inputExpression>
        </input>
        <output id="_out_5135e951bcd6" name="ruleId" typeRef="types.tRuleId"/>
        <output id="_out_41f6415f300b" name="description" typeRef="string"/>
        <output id="_out_9494ec396c8d" name="amount" typeRef="types.tAmount"/>
        <annotation name="Specification rule"/>
        <rule id="_rule_28a0139a6e63">
          <inputEntry id="_rule_28a0139a6e63_i0">
            <text>"DEVELOPING"</text>
          </inputEntry>
          <inputEntry id="_rule_28a0139a6e63_i1">
            <text>&gt;= 3</text>
          </inputEntry>
          <inputEntry id="_rule_28a0139a6e63_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_28a0139a6e63_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_28a0139a6e63_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_28a0139a6e63_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_28a0139a6e63_o0">
            <text>"MOD-DED-01"</text>
          </outputEntry>
          <outputEntry id="_rule_28a0139a6e63_o1">
            <text>"Developing band in a level 3 or above role, ramp-up plan needed, -5%"</text>
          </outputEntry>
          <outputEntry id="_rule_28a0139a6e63_o2">
            <text>- baseSalary * 0.05</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-DED-01</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_ab1e8e8cec35">
          <inputEntry id="_rule_ab1e8e8cec35_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ab1e8e8cec35_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ab1e8e8cec35_i2">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_ab1e8e8cec35_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ab1e8e8cec35_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_ab1e8e8cec35_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_ab1e8e8cec35_o0">
            <text>"MOD-DED-02"</text>
          </outputEntry>
          <outputEntry id="_rule_ab1e8e8cec35_o1">
            <text>"Missing a hard requirement that will be trained, -3%"</text>
          </outputEntry>
          <outputEntry id="_rule_ab1e8e8cec35_o2">
            <text>- baseSalary * 0.03</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-DED-02</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_c4702db6c4f3">
          <description>The only rule that scales the running total rather than the base.</description>
          <inputEntry id="_rule_c4702db6c4f3_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_c4702db6c4f3_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_c4702db6c4f3_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_c4702db6c4f3_i3">
            <text>&lt; 1</text>
          </inputEntry>
          <inputEntry id="_rule_c4702db6c4f3_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_c4702db6c4f3_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_c4702db6c4f3_o0">
            <text>"MOD-DED-03"</text>
          </outputEntry>
          <outputEntry id="_rule_c4702db6c4f3_o1">
            <text>"Reduced schedule, the whole offer is pro-rated to the agreed fraction"</text>
          </outputEntry>
          <outputEntry id="_rule_c4702db6c4f3_o2">
            <text>- subtotal * (1 - partTimeFraction)</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-DED-03</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_740465d128e4">
          <inputEntry id="_rule_740465d128e4_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_740465d128e4_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_740465d128e4_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_740465d128e4_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_740465d128e4_i4">
            <text>true</text>
          </inputEntry>
          <inputEntry id="_rule_740465d128e4_i5">
            <text>-</text>
          </inputEntry>
          <outputEntry id="_rule_740465d128e4_o0">
            <text>"MOD-DED-04"</text>
          </outputEntry>
          <outputEntry id="_rule_740465d128e4_o1">
            <text>"Market with employer-funded statutory benefits above the US baseline, -2%"</text>
          </outputEntry>
          <outputEntry id="_rule_740465d128e4_o2">
            <text>- baseSalary * 0.02</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-DED-04</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_6a96f2df9794">
          <inputEntry id="_rule_6a96f2df9794_i0">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6a96f2df9794_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6a96f2df9794_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6a96f2df9794_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6a96f2df9794_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="_rule_6a96f2df9794_i5">
            <text>true</text>
          </inputEntry>
          <outputEntry id="_rule_6a96f2df9794_o0">
            <text>"MOD-DED-05"</text>
          </outputEntry>
          <outputEntry id="_rule_6a96f2df9794_o1">
            <text>"Contract to hire, recalculated on conversion, -4%"</text>
          </outputEntry>
          <outputEntry id="_rule_6a96f2df9794_o2">
            <text>- baseSalary * 0.04</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-DED-05</text>
          </annotationEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
    <authorityRequirement id="_ar_a7cb1270cb05">
      <requiredAuthority href="#_ks_bef83d402603"/>
    </authorityRequirement>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_5b2cceeaf85c" name="Deductions">
    <variable id="_var_ecf594701afd" name="Deductions" typeRef="types.tModifierResult"/>
    <encapsulatedLogic id="_fn_bc00cc82389d" kind="FEEL" typeRef="types.tModifierResult">
      <formalParameter id="_fp_5a2940f383db" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_dd63284e8738" name="subtotal" typeRef="number"/>
      <formalParameter id="_fp_64aae1712406" name="band" typeRef="types.tSeniorityBand"/>
