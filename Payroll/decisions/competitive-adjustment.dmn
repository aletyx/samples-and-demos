  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_diag_6ebb60db83a3" name="DRD">
      <dmndi:DMNShape id="_shape_c61dc6918561" dmnElementRef="_ks_d089aa956da3">
        <dc:Bounds height="70" width="180" x="280" y="190"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_c99aee78959f" dmnElementRef="_bkm_4fdbb291daf0">
        <dc:Bounds height="70" width="180" x="720" y="190"/>
