  <businessKnowledgeModel id="_bkm_c0935c42688f" name="Competitive Adjustment">
    <description>Evaluated against the subtotal of every other group, because MOD-CMP-01 matches a competing offer against the whole offer.</description>
    <variable id="_var_b62cc7385550" name="Competitive Adjustment" typeRef="types.tModifierResult"/>
    <encapsulatedLogic id="_fn_3fd549d1d0c3" kind="FEEL" typeRef="types.tModifierResult">
      <formalParameter id="_fp_80eee12d7c96" name="subtotal" typeRef="number"/>
      <formalParameter id="_fp_b39df078cbab" name="rangeMaximumAdjusted" typeRef="number"/>
      <formalParameter id="_fp_5243246e1ff7" name="competingOffer" typeRef="types.tMoney"/>
      <formalParameter id="_fp_8ff0877f75f9" name="competingOfferVerified" typeRef="boolean"/>
      <formalParameter id="_fp_daf0a59252f0" name="competingOfferIsOTE" typeRef="boolean"/>
      <formalParameter id="_fp_4872419ce7aa" name="referralSource" typeRef="types.tReferralSource"/>
      <formalParameter id="_fp_928e94c39283" name="salaryHistoryBanned" typeRef="boolean"/>
      <formalParameter id="_fp_637b9f2878ad" name="currentSalary" typeRef="types.tMoney"/>
      <formalParameter id="_fp_26b023b05857" name="noticePeriodDays" typeRef="types.tDays"/>
      <formalParameter id="_fp_d258bbf8b05e" name="requisitionStatus" typeRef="types.tRequisitionStatus"/>
      <formalParameter id="_fp_fec722a52ae2" name="isCommissionRole" typeRef="boolean"/>
      <formalParameter id="_fp_aa39506e61bc" name="isExecutiveRole" typeRef="boolean"/>
      <context id="_ctx_4136eb0a2e4e" typeRef="types.tModifierResult">
        <contextEntry id="_ce_3f7b02bd00a6">
          <variable id="_cev_fc3dd67c4bfd" name="competingRatio" typeRef="number"/>
          <literalExpression id="_le_be237220ba85">
            <text>if competingOffer = null or subtotal = null or subtotal = 0
then null else competingOffer / subtotal</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_aa31a053e4c8">
          <variable id="_cev_538945d3b62d" name="rules" typeRef="types.tAppliedRuleList"/>
          <literalExpression id="_le_2e319bcf54ec">
            <text>Competitive Rules(subtotal, rangeMaximumAdjusted, competingOffer,
  competingRatio, competingOfferVerified, referralSource,
  salaryHistoryBanned, currentSalary)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_e904861a979c">
          <variable id="_cev_890a02cdb2dd" name="raised" typeRef="types.tFlagList"/>
          <literalExpression id="_le_b2ad5d59199e">
            <text>Competitive Flags(competingRatio, competingOfferVerified, noticePeriodDays,
  requisitionStatus, isCommissionRole, competingOfferIsOTE, isExecutiveRole)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_a49977eb866d">
          <literalExpression id="_le_19eea8ea4362">
            <text>{ amount: common.Sum Of Rules(rules),
  appliedRules: if rules = null then [] else rules,
  flags: if raised = null then [] else raised }</text>
          </literalExpression>
        </contextEntry>
      </context>
    </encapsulatedLogic>
