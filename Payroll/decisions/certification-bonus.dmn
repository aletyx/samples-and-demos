        <rule id="_rule_2aa668ab2d43">
          <description>CFA charterholder</description>
          <inputEntry id="_rule_2aa668ab2d43_i0">
            <text>"FIN-CFA"</text>
          </inputEntry>
          <outputEntry id="_rule_2aa668ab2d43_o0">
            <text>["FIN-", "COR-FIN-"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_bd5529765b99">
          <description>Bar admission in the jurisdiction the role serves</description>
          <inputEntry id="_rule_bd5529765b99_i0">
            <text>"LEG-BAR"</text>
          </inputEntry>
          <outputEntry id="_rule_bd5529765b99_o0">
            <text>["LEG-", "COR-LEG-3"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_4ffe0bfdecd1">
          <description>Privacy certification such as CIPP/E or CIPP/US</description>
          <inputEntry id="_rule_4ffe0bfdecd1_i0">
            <text>"PRV-CIPP"</text>
          </inputEntry>
          <outputEntry id="_rule_4ffe0bfdecd1_o0">
            <text>["LEG-PRV-3", "LEG-CMP-3", "LEG-RSK-3", "ENG-SEC-", "COR-LEG-3"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_cefe8fe477a6">
          <description>SHRM-SCP, SPHR or national HR equivalent</description>
          <inputEntry id="_rule_cefe8fe477a6_i0">
            <text>"HR-SHRM"</text>
          </inputEntry>
          <outputEntry id="_rule_cefe8fe477a6_o0">
            <text>["PPL-", "COR-HR-2", "COR-REC-2"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_149fda065b9d">
          <description>Project Management Professional</description>
          <inputEntry id="_rule_149fda065b9d_i0">
            <text>"PM-PMP"</text>
          </inputEntry>
          <outputEntry id="_rule_149fda065b9d_o0">
            <text>["PRD-TPM-", "OPS-PMO-3", "OPS-STR-3", "CSX-PS-3", "CSX-IMP-2"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_a711bb4e88a7">
          <description>Vendor certification on the company's CRM or sales platform</description>
          <inputEntry id="_rule_a711bb4e88a7_i0">
            <text>"SAL-CRM"</text>
          </inputEntry>
          <outputEntry id="_rule_a711bb4e88a7_o0">
            <text>["GTM-", "MKT-OPS-2", "CSX-"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
        <rule id="_rule_c0d94a12c623">
          <description>Recognized marketing analytics or automation certification</description>
          <inputEntry id="_rule_c0d94a12c623_i0">
            <text>"MKT-ANL"</text>
          </inputEntry>
          <outputEntry id="_rule_c0d94a12c623_o0">
            <text>["MKT-", "GTM-MKT-2", "DAT-ANL-"]</text>
          </outputEntry>
          <annotationEntry>
            <text>MOD-CRT-92</text>
          </annotationEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
    <authorityRequirement id="_ar_d88c70018a7b">
      <requiredAuthority href="#_ks_0ec0a16b9a4c"/>
    </authorityRequirement>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_eed69853a095" name="Certification Relevant">
    <description>MOD-CRT-92. A certification outside its mapped roles scores nothing.</description>
    <variable id="_var_cbd9f07bb57d" name="Certification Relevant" typeRef="boolean"/>
    <encapsulatedLogic id="_fn_a2604ee9e0a4" kind="FEEL" typeRef="boolean">
      <formalParameter id="_fp_808e25d21318" name="certification" typeRef="types.tCertificationCode"/>
      <formalParameter id="_fp_43491603fb1f" name="roleCode" typeRef="types.tRoleCode"/>
      <literalExpression id="_le_37b99a0b6b5f">
        <text>some prefix in Certification Scope(certification)
satisfies starts with(roleCode, prefix)</text>
      </literalExpression>
    </encapsulatedLogic>
    <knowledgeRequirement id="_kr_53e6f3ed3da7">
      <requiredKnowledge href="#_bkm_99af9c58c89c"/>
    </knowledgeRequirement>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_4045c7baf6a7" name="Certification Bonus">
    <description>Applies MOD-CRT-91 (PhD excludes Master's), then MOD-CRT-90 (the two highest only). Expired certifications are rejected in validation under MOD-CRT-93, not here.</description>
    <variable id="_var_909bdd31df1a" name="Certification Bonus" typeRef="types.tModifierResult"/>
    <encapsulatedLogic id="_fn_e7462c49c870" kind="FEEL" typeRef="types.tModifierResult">
      <formalParameter id="_fp_24f5b3dde637" name="baseSalary" typeRef="number"/>
      <formalParameter id="_fp_ddb22b56fd87" name="certifications" typeRef="types.tCertificationList"/>
      <formalParameter id="_fp_2d3910384105" name="roleCode" typeRef="types.tRoleCode"/>
      <context id="_ctx_65636528fdbc" typeRef="types.tModifierResult">
        <contextEntry id="_ce_e9e6d729bcb4">
          <variable id="_cev_fc231a5ea702" name="declared" typeRef="types.tCertificationList"/>
          <literalExpression id="_le_7ab2077f6fde">
            <text>if certifications = null then [] else certifications</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_b4afeba0f144">
          <variable id="_cev_d332fa3041cd" name="relevant" typeRef="types.tCertificationList"/>
          <literalExpression id="_le_4ad2ad8dbc04">
            <text>declared[Certification Relevant(item, roleCode)]</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_4be73e0bb028">
          <variable id="_cev_371161899e84" name="deduped" typeRef="types.tCertificationList"/>
          <literalExpression id="_le_b20334ad15d4">
            <text>if list contains(relevant, "PHD-FIELD")
then relevant[item != "MS-FIELD"] else relevant</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_99b43853a08b">
          <variable id="_cev_fb0edad96fba" name="scored"/>
          <literalExpression id="_le_c787025c2c75">
            <text>for c in deduped return
  { code: c, rate: Certification Rate(c), ruleId: Certification Rule Id(c) }</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_66b6a0ba4064">
          <variable id="_cev_30cb44006ae3" name="paying"/>
          <literalExpression id="_le_43203ae5ed76">
            <text>scored[rate &gt; 0]</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_76eeba7c8939">
          <variable id="_cev_b82fb631b03f" name="ranked"/>
          <literalExpression id="_le_efc65f42a31f">
            <text>sort(paying, function(a, b) a.rate &gt; b.rate)</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_cb33aeaab531">
          <variable id="_cev_66f0733b28ab" name="top"/>
          <literalExpression id="_le_ecf628e8de6f">
            <text>if count(ranked) &gt; 2 then sublist(ranked, 1, 2) else ranked</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_7e953371bf79">
          <variable id="_cev_e1e38d285262" name="prerequisites"/>
          <literalExpression id="_le_9b8d4928e0dc">
            <text>deduped[Certification Rate(item) = 0]</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_ef10303daf01">
          <literalExpression id="_le_55eee960cc82">
            <text>{ amount: if count(top) = 0 then 0
    else sum(for t in top return baseSalary * t.rate),
  appliedRules: concatenate(
    for t in top return
      { ruleId: t.ruleId,
        description: t.code + " adds " + string(decimal(t.rate * 100, 1)) + "% of base",
        amount: baseSalary * t.rate },
    for p in prerequisites return
      { ruleId: "MOD-CRT-94",
        description: p + " is a prerequisite for this role, not a bonus",
        amount: 0 }),
  flags: [] }</text>
          </literalExpression>
        </contextEntry>
      </context>
    </encapsulatedLogic>
    <knowledgeRequirement id="_kr_a06d83edfda8">
      <requiredKnowledge href="#_bkm_eed69853a095"/>
    </knowledgeRequirement>
    <knowledgeRequirement id="_kr_cad505310e49">
      <requiredKnowledge href="#_bkm_03b8eec1306f"/>
    </knowledgeRequirement>
    <knowledgeRequirement id="_kr_433128f3e362">
      <requiredKnowledge href="#_bkm_d416e855cd18"/>
    </knowledgeRequirement>
    <authorityRequirement id="_ar_e00cc2b2deef">
      <requiredAuthority href="#_ks_0ec0a16b9a4c"/>
    </authorityRequirement>
  </businessKnowledgeModel>
