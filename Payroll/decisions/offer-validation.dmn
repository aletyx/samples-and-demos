<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             xmlns:kie="http://www.drools.org/kie/dmn/1.2"
             id="_defs_f61b85143ee2" name="Offer Validation" namespace="https://aletyx.ai/dmn/payroll/offer-validation"
             exporter="Aletyx Payroll sample" exporterVersion="1.0">
  <description>Input validation, kept separate from the policy logic.</description>
  <import id="_imp_a1e7a8cafbfd" name="types" importType="https://www.omg.org/spec/DMN/20230324/MODEL/" namespace="https://aletyx.ai/dmn/payroll/types" locationURI="payroll-types.dmn"/>
  <knowledgeSource id="_ks_86a67208e073" name="Data Quality Standard" locationURI="../spec/candidate_offer.md#3-inputs">
    <description>Section 3: the inputs the calculation needs. Bad data is trapped here at the boundary so the policy models never carry validation logic.</description>
    <type>Policy document</type>
  </knowledgeSource>
  <businessKnowledgeModel id="_bkm_be57d14e8ebf" name="is Counsel Role">
    <description>Roles in section 4.7 whose title contains Counsel.</description>
    <variable id="_var_40163b50d84e" name="is Counsel Role" typeRef="boolean"/>
    <encapsulatedLogic id="_fn_991f4e70a123" kind="FEEL" typeRef="boolean">
      <formalParameter id="_fp_ffe2fb0cd818" name="roleCode" typeRef="types.tRoleCode"/>
      <literalExpression id="_le_fe26aa08baab">
        <text>list contains(
  ["COR-LEG-3", "LEG-CNS-4", "LEG-PRV-3", "LEG-IPC-4", "LEG-GC"],
  roleCode)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="_bkm_be4f98aad628" name="Candidate Validation">
    <description>Trapping bad data at the boundary keeps the policy models free of validation logic (practice 4). Unknown role and market codes are already impossible because the types are enumerations.</description>
    <variable id="_var_58af7d54888e" name="Candidate Validation" typeRef="types.tValidation"/>
    <encapsulatedLogic id="_fn_8255b46a15e3" kind="FEEL" typeRef="types.tValidation">
      <formalParameter id="_fp_42a067307892" name="candidate" typeRef="types.tCandidate"/>
      <context id="_ctx_dd77fde3135f" typeRef="types.tValidation">
        <contextEntry id="_ce_d08d74afe53b">
          <variable id="_cev_9113d6655e7c" name="errors"/>
          <literalExpression id="_le_190c2b0f607f">
            <text>flatten([
  if candidate.roleCode = null then ["roleCode is required"] else [],
  if candidate.seniorityScore = null
    then ["seniorityScore is required, see section 5"] else [],
  if candidate.marketCode = null
    then ["marketCode is required, see MOD-MKT-90"] else [],
  if candidate.relocationRequired = true
     and (candidate.relocationScope = null or candidate.relocationScope = "none")
    then ["relocationScope must say domestic or international when relocation is required, see MOD-LOC-01 and MOD-LOC-02"] else [],
  if candidate.competingOffer != null and candidate.competingOfferVerified = null
    then ["competingOfferVerified must be stated when a competing offer is recorded, see MOD-CMP-03"] else [],
  if is Counsel Role(candidate.roleCode)
     and not(list contains(
       if candidate.certifications = null then [] else candidate.certifications,
       "LEG-BAR"))
    then ["bar admission is a prerequisite for a Counsel role, see MOD-CRT-94"] else [],
  if candidate.yearsExperience = null
    then ["yearsExperience is required, see MOD-EXP-01"] else []
])</text>
          </literalExpression>
        </contextEntry>
        <contextEntry id="_ce_0204b651dac1">
          <literalExpression id="_le_a98e779c713a">
            <text>{ isValid: count(errors) = 0, errors: errors }</text>
          </literalExpression>
        </contextEntry>
      </context>
    </encapsulatedLogic>
    <knowledgeRequirement id="_kr_0e6118f29811">
      <requiredKnowledge href="#_bkm_be57d14e8ebf"/>
    </knowledgeRequirement>
    <authorityRequirement id="_ar_eb3c6578c763">
      <requiredAuthority href="#_ks_86a67208e073"/>
    </authorityRequirement>
  </businessKnowledgeModel>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_diag_faae11154fc6" name="DRD">
      <dmndi:DMNShape id="_shape_58f1457cd712" dmnElementRef="_ks_86a67208e073">
        <dc:Bounds height="70" width="180" x="60" y="190"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_437806a30687" dmnElementRef="_bkm_be57d14e8ebf">
        <dc:Bounds height="70" width="180" x="280" y="190"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_05f362728ff0" dmnElementRef="_bkm_be4f98aad628">
        <dc:Bounds height="70" width="180" x="60" y="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="_edge_f2f21f75726a" dmnElementRef="_kr_0e6118f29811">
        <di:waypoint x="370" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_edge_f2ea6f3fd8d2" dmnElementRef="_ar_eb3c6578c763">
        <di:waypoint x="150" y="190"/>
        <di:waypoint x="150" y="130"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
