    <description>Section 4 of the candidate offer specification: the reference salary range for every role in the company, quoted at market index 1.00.</description>
    <type>Policy document</type>
  </knowledgeSource>
  <businessKnowledgeModel id="_bkm_8f52e93399ff" name="Salary Range For Role">
