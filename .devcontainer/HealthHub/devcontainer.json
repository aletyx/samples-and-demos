{
  // ---------------------------------------------------------------------
  // HealthHub
  //
  // A demo with a database: a Flutter app (web, Android, iOS, Linux), a
  // Dart API and PostgreSQL. For now the app says hello, with the
  // greeting read from the database through the API; aityx comes next.
  //
  // Source:  https://github.com/aletyx/samples-and-demos (HealthHub/)
  // Rules:   https://aityx.ai
  // Aletyx:  https://aletyx.com
  //          https://nu01.com
  //
  // This repository holds several samples. This dev container is
  // HealthHub, in HealthHub/ — not Contact Hub, Mortgage Hub, PokerFace,
  // Mortgage_Process or Payroll.
  // The name below is what GitHub shows in the "Dev container
  // configuration" list when you create a codespace.
  // ---------------------------------------------------------------------
  "name": "HealthHub",
  // The published image (image/Containerfile, built and pushed by
  // image/build-image.sh): Flutter, the GitHub CLI, process-compose and
  // every demo's release web build, so nothing is built when a codespace
  // is created and the demos start in seconds. The organization has
  // GitHub's prebuilds switched off; this is the next best thing.
  "image": "docker.io/aletyxcode/samples-and-demos-devcontainer:latest",
  "remoteUser": "vscode",
  // An SSH server, so `gh codespace ssh`, `gh codespace cp` and
  // `gh codespace logs` reach the codespace from a terminal: that is how
  // startup.log is read without the editor, and how the demos are
  // benchmarked. Docker, for PostgreSQL: HealthHub's database is the
  // postgres container of HealthHub/compose.yaml, which process-compose
  // starts with `docker compose up postgres`.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // The web server must listen on every interface for the forwarded
  // port to reach it (only the container sees it).
  "containerEnv": {
    // The demos run on the image's Flutter and process-compose, not devbox
    // (see demos-toolchain.sh).
    "DEMOS_TOOLCHAIN": "image",
    "HEALTHHUB_BIND_HOST": "0.0.0.0"
  },
  // Your own key, never the repository's: the same AITYX_API_KEY secret as
  // Mortgage Hub's and Contact Hub's. Codespaces secrets belong to a user
  // and are granted per repository, so a key already granted to this
  // repository for either reaches this container too, with nothing to
  // copy. GitHub asks for it when you create a codespace unless you
  // already hold it, and passes it in as an environment variable, which
  // the scripts read before falling back to HealthHub/.env. Change it at
  // https://github.com/settings/codespaces.
  //
  // AITYX_URL is optional and defaults to https://api.aityx.ai. Set the
  // secret to https://api-stage.aityx.ai when using a stage key.
  "secrets": {
    "AITYX_API_KEY": {
      "description": "Your own aityx.ai API key, from the console's API keys page; the same one Mortgage Hub and Contact Hub use. HealthHub will run its decisions on aityx.",
      "documentationUrl": "https://aityx.ai/docs"
    },
    "AITYX_URL": {
      "description": "Optional. API endpoint; leave unset for https://api.aityx.ai, or set https://api-stage.aityx.ai for a stage key."
    }
  },
  // The image's flutter and dart on the PATH of every terminal.
  // ${containerEnv:PATH} is the image's own PATH. Inside `devbox shell`
  // and `devbox services up`, devbox's Flutter, the same version, comes
  // first.
  "remoteEnv": {
    "PATH": "/opt/flutter/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // The Flutter SDK in the image (see image/Containerfile), there
        // from the moment VS Code attaches, so the Dart extension doesn't offer
        // to download one.
        "dart.flutterSdkPath": "/opt/flutter"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  // Only the web app's port. The API (9801) and PostgreSQL (9802) stay
  // inside the container: the app reaches the API through the web
  // server's /api/ proxy, and the API reaches the database on localhost.
  // The port's bare URL redirects to the app at /app/. Plain HTTP, which
  // is what the dev server speaks; switching a public port to HTTPS makes
  // it private. post-start.sh makes it public, which devcontainer.json
  // cannot.
  "forwardPorts": [9800],
  "portsAttributes": {
    "9800": {
      "label": "HealthHub web app",
      "protocol": "http",
      "onAutoForward": "openBrowserOnce"
    }
  },
  // All run from the repository root and move to HealthHub/ themselves, in
  // this order, when the codespace is created; the editor attaches after
  // the first (waitFor), while any build goes on in the background with
  // its progress in HealthHub/startup.log. (The first two are also what a
  // Codespaces prebuild would snapshot, were prebuilds allowed.)
  //   on-create.sh       the image's release web build into the workspace
  //                      (image/restore-builds.sh)
  //   update-content.sh  scripts/build.sh: the release web build and the
  //                      compiled servers, only what changed
  //   post-create.sh     whether the aityx secrets arrived
  // post-start.sh starts the services and makes the port public on every
  // start.
  "onCreateCommand": "bash -lc 'bash .devcontainer/HealthHub/on-create.sh'",
  "updateContentCommand": "bash -lc 'bash .devcontainer/HealthHub/update-content.sh'",
  "postCreateCommand": "bash -lc 'bash .devcontainer/HealthHub/post-create.sh'",
  "waitFor": "onCreateCommand",
  "postStartCommand": "bash -lc 'bash .devcontainer/HealthHub/post-start.sh'",
  // Again each time VS Code attaches: a visibility set at start does not
  // always stick, and users report it does from here.
  "postAttachCommand": "bash .devcontainer/HealthHub/public-port.sh"
}
