{
  // ---------------------------------------------------------------------
  // Cellfie
  //
  // Conway's Game of Life on an infinite board, with the rules as a
  // decision model on aityx.ai: a Flutter app (web, Android, iOS, Linux)
  // shows the board and the calls, and a Dart API asks aityx what
  // happens to every situation on the board, one call per generation.
  //
  // Source:  https://github.com/aletyx/samples-and-demos (Cellfie/)
  // Rules:   https://aityx.ai — runs the rules of Life
  // Aletyx:  https://aletyx.com
  //          https://nu01.com
  //
  // This repository holds several samples. This dev container is Life
  // Hub, in Cellfie/ — not Contact Hub, Mortgage Hub, Mortgage_Process or
  // Payroll.
  // The name below is what GitHub shows in the "Dev container
  // configuration" list when you create a codespace.
  // ---------------------------------------------------------------------
  "name": "Cellfie",
  "build": {
    "dockerfile": "Containerfile",
    // Nothing is copied into the image, so the build context is just this
    // folder rather than the whole repository.
    "context": "."
  },
  "remoteUser": "vscode",
  // An SSH server, so `gh codespace ssh`, `gh codespace cp` and
  // `gh codespace logs` reach the codespace from a terminal: that is how
  // startup.log is read without the editor, and how the demos are
  // benchmarked.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // The dev servers must listen on every interface for the forwarded
  // ports to reach them (only the container sees them).
  "containerEnv": {
    "CELLFIE_BIND_HOST": "0.0.0.0"
  },
  // Your own key, never the repository's: the same AITYX_API_KEY secret as
  // Mortgage Hub's and Contact Hub's. Codespaces secrets belong to a user
  // and are granted per repository, so a key already granted to this
  // repository for either reaches this container too, with nothing to copy. GitHub asks for
  // it when you create a codespace unless you already hold it, and passes
  // it in as an environment variable, which the scripts read before
  // falling back to Cellfie/.env. Change it at
  // https://github.com/settings/codespaces.
  //
  // AITYX_URL defaults to https://api.aityx.ai; set the secret to use
  // another endpoint. Both values are passed only to the API process.
  "secrets": {
    "AITYX_API_KEY": {
      "description": "Your own aityx.ai API key, from the console's API keys page; the same one Mortgage Hub and Contact Hub use. Cellfie runs the rules of Life on aityx.",
      "documentationUrl": "https://aityx.ai/docs"
    },
    "AITYX_URL": {
      "description": "Optional aityx.ai API endpoint; defaults to https://api.aityx.ai.",
      "documentationUrl": "https://aityx.ai/docs"
    }
  },
  // The image's flutter and dart on the PATH of every terminal.
  // ${containerEnv:PATH} is the image's own PATH. Inside `devbox shell`
  // and `devbox services up`, devbox's Flutter, the same version, comes
  // first.
  "remoteEnv": {
    "PATH": "/opt/flutter/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // The Flutter SDK baked into the image (see Containerfile), there
        // from the moment VS Code attaches. Devbox's own Flutter only
        // appears once on-create.sh has run `devbox install`, too late
        // for the Dart extension, which then offers to download one.
        "dart.flutterSdkPath": "/opt/flutter"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  // Only the web app's port. The API (8931) stays inside the container:
  // the app reaches it through the web server's /api/ proxy. The port's
  // bare URL redirects to the app at /app/. Plain HTTP, which is what the
  // dev server speaks; switching a public port to HTTPS makes it private.
  // post-start.sh makes it public, which devcontainer.json cannot.
  "forwardPorts": [8930],
  "portsAttributes": {
    "8930": {
      "label": "Cellfie web app",
      "protocol": "http",
      "onAutoForward": "openBrowserOnce"
    }
  },
  // All run from the repository root and move to Cellfie/ themselves, in
  // this order. The first two run in a Codespaces prebuild too (Settings →
  // Codespaces → Set up prebuild), whose snapshot then holds the toolchain
  // and the build, so a codespace created from it only reports the
  // secrets and starts the app; post-create.sh never runs in a prebuild,
  // which has no user secrets. Without a prebuild all three run when the
  // codespace is created, and the editor attaches after the first
  // (waitFor), while the build goes on in the background with its
  // progress in Cellfie/startup.log.
  //   on-create.sh       `devbox install`
  //   update-content.sh  scripts/build.sh: the release web build and the
  //                      compiled servers, only what changed
  //   post-create.sh     whether the aityx secrets arrived
  // post-start.sh starts the services and makes the port public on every
  // start.
  "onCreateCommand": "bash -lc 'bash .devcontainer/Cellfie/on-create.sh'",
  "updateContentCommand": "bash -lc 'bash .devcontainer/Cellfie/update-content.sh'",
  "postCreateCommand": "bash -lc 'bash .devcontainer/Cellfie/post-create.sh'",
  "waitFor": "onCreateCommand",
  "postStartCommand": "bash -lc 'bash .devcontainer/Cellfie/post-start.sh'",
  // Again each time VS Code attaches: a visibility set at start does not
  // always stick, and users report it does from here.
  "postAttachCommand": "bash .devcontainer/Cellfie/public-port.sh"
}
